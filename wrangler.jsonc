{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "web-typing",
	"main": "./src/server/index.ts",
	"compatibility_date": "2026-04-13",
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS",
		"run_worker_first": ["/api/*"],
		"not_found_handling": "single-page-application"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "RACE_ROOMS",
				"class_name": "RaceRoom"
			}
		]
	},
	"exports": {
		"RaceRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
